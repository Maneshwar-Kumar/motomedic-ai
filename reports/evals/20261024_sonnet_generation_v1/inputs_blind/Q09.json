       0,
       75
      ]
     },
     {
      "evidence_id": "evidence_b345d26bcf46960f7125d8d8",
      "exact_text": " Customer to ensure USB port cap is closed and locked properly when not in use, warranty will not be provided if port cap is damaged and not sealed properly.",
      "provenance": [
       {
        "bbox": {
         "b": 37.37411875589066,
         "coord_origin": "BOTTOMLEFT",
         "l": 21.5718,
         "r": 215.1078,
