        "page_no": 65
       }
      ],
      "text_sha256": "879f53d853bd788f0736b0b470a5fad06514c8c93db75e9972eee65efc223504",
      "text_span": [
       0,
       158
      ]
     },
     {
      "evidence_id": "evidence_ea69e5fbd3ff27f1dd159960",
      "exact_text": " If high current draw greater than 2.5 A is observed USB charger will shutdown please check your smart phone battery current ratings before using.",
      "provenance": [
       {
        "bbox": {
         "b": 184.57411875589068,
         "coord_origin": "BOTTOMLEFT",
         "l": 225.02779999999998,
         "r": 418.7110000000002,
         "t": 211.252
        },
        "charspan": [
         0,
         147
        ],
        "page_no": 65
       }
      ],
      "text_sha256": "f1710c7c824a8107cb87b09f6c51e7d8b546d787dac743fe2618ef3edaaf7073",
      "text_span": [
       0,
       147
      ]
     }
    ],
    "text": "Keep the port cap closed and locked when not in use. The manual warns that warranty will not be provided if the cap is damaged and the port is not properly sealed."
   },
   {
    "claim_id": "readonly-warning-32913a617076a4dac95b",
    "text": "The manual recommends avoiding charger use in rain to prevent damage to the phone and charger.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_31f9ffe7f325a580f7c58947"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-d3ea7d21047d84982654",
    "text": "The port is limited to one mobile phone at a time; other devices are not permitted.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_f5f14378db31693f76bd2a81"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-f5d18550c12d98b19945",
    "text": "The USB cable must be inserted correctly; damage from hard or incorrect insertion is excluded from warranty.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_a4a384cb8cd1cd437ac00907"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-64382ee449b823406fb6",
    "text": "An open or partly closed unused port cap creates a short-circuit risk.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_f4f3ea7f748d6732d21cae42"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-1674a8a84928f48bcf8e",
    "text": "Metal or conductive material inside the port can cause a short circuit.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_87d7aaf9a6f68c203a240607"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-4172911ed398e32487a9",
    "text": "The port cap must be closed and locked when unused; a damaged or improperly sealed cap is excluded from warranty.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_b345d26bcf46960f7125d8d8"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-6ea2845447f1286f734a",
    "text": "The charger shuts down if current draw exceeds 2.5 A; the manual requires checking phone battery current ratings before use.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_ea69e5fbd3ff27f1dd159960"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-9b8dd85f39807c72d76a",
    "text": "The charger functions only while the engine is running.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_13dac6aaee2fcbdd57618d29"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-55965ed5394819f51226",
    "text": "The manual specifies standard approved high-quality USB cables for proper function.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_a35159dd2d88b584ad319de1"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "claim_cfca58b621889279a52cd8b6",
