  "server_required_source_display": [
   {
    "claim_id": "structural-v2-luggage_and_accessory_loading-1",
    "text": "Do not exceed 110 km/h when riding solo, carrying a pillion or payload on an accessory-equipped motorcycle.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_41ddc000f6abdfa3a402fa60"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "structural-v2-luggage_and_accessory_loading-2",
    "text": "Do not load weight or install accessories incorrectly; doing so may affect the motorcycle's stability, handling characteristics and safe operation and could result in an accident causing serious injury or loss of life.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_b45cd32783b18b7a0f3a6bd3"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "structural-v2-luggage_and_accessory_loading-3",
    "text": "Royal Enfield cautions you against use of non-standard parts such as aftermarket and custom-made extended front forks, which may adversely affect performance and handling. Removing or altering original parts may adversely affect the performance of the motorcycle, causing an accident, which could result in serious injury or loss of life.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_a4bb14d7d40e42aa7a1abdc2",
     "evidence_32a2dfb5649c03d469c7a578"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "structural-v2-luggage_and_accessory_loading-4",
    "text": "Do not ignore model/design specifications; doing so constitutes motorcycle and accessories misuse, which may adversely affect handling and performance, causing an accident which could result in serious injury or loss of life.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_bbf3e2f088553465b973f78e"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-7fcd820ea17ed2a6850e",
    "text": "Listed values and dimensions are guidance only.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_6058a38ed55c9b65bad75313"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-ee0d599b64d411fa4149",
    "text": "Specifications may change without prior notice as the product is improved.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_655747f05f4a0b2df006062a"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
   },
   {
    "claim_id": "readonly-warning-901e043bcef477f60f95",
    "text": "The vehicle must not exceed its allowed gross weight; suspension and tyres are designed only up to that maximum.",
    "response_role": "WARNING",
    "evidence_ids": [
     "evidence_f215ffd94a6c830c1ba6dfb0"
    ],
    "presentation_mode": "REVIEWED_PARAPHRASE"
