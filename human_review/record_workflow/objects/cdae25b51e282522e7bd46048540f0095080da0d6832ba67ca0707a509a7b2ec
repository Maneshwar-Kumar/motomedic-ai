"""Coordinator for the owner-authorized GEN001..GEN100 engineering batch."""
import argparse
from collections import Counter
from datetime import datetime, timezone
import json
from pathlib import Path
import re

from workflow import MANUAL_SHA, ORIGIN, Store, digest, encoded, require

ACTORS = {"author": "batch100-author", "reviewer": "batch100-source-reviewer", "judge": "batch100-feedback-judge"}
FOLDERS = {"author": "drafts", "reviewer": "reviews", "judge": "judgments"}
SUFFIXES = {"author": "", "reviewer": "_review", "judge": "_judgment"}
TERMINAL = {"PASS_AGENT_REVIEW", "BLOCKED_SOURCE_GAP", "BLOCKED_HUMAN_REVIEW", "BLOCKED_AUDIT"}


def atomic_json(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(path.suffix + ".pending")
    temp.write_bytes(encoded(payload))
    temp.replace(path)


def exclusive_text(path, content):
    data = content.encode("utf-8")
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        require(path.read_bytes() == data, "Existing immutable card differs: " + str(path))
    else:
        with path.open("xb") as file:
            file.write(data)


class Batch:
    def __init__(self, root):
        self.store = Store(root)
        self.root = self.store.root
        self.home = self.store.home / "batch_100"
        self.ids = [f"GEN{i:03d}" for i in range(1, 101)]

    def init(self):
        path = self.home / "batch_context.json"
        require(not path.exists(), "Batch already initialized; do not reset it")
        existing = {e["payload"]["record_id"] for e in self.store.ledger() if e["kind"] == "SUBMISSION"}
        require(not set(self.ids) & existing, "Reserved IDs collide with existing native records")
        for rid in self.ids:
            require(not list(self.home.glob(f"*/{rid}_v*.json")), "Batch ID already has artifacts")
        context = self.store.context()
        context["batch_spec_sha256"] = self.store.freeze((self.home / "COORDINATION.md").read_bytes())
        sha = self.store.freeze(encoded(context))
        frozen = {"batch_id": "native-100-20261010", "batch_context_sha256": sha, "manual_sha256": MANUAL_SHA,
                  "ids": self.ids, "actors": ACTORS, "maximum_revision_cycles": 3, "context": context,
                  "human_acceptance": "NOT_RECORDED", "formal_source_approval": "PENDING", "runtime_authorized": False}
        with path.open("xb") as f:
            f.write(encoded(frozen))
        self.store.append("BATCH_STARTED", {"batch_id": frozen["batch_id"], "context_sha256": sha, "record_ids": self.ids})
        return frozen

    def spec(self):
        result = json.loads((self.home / "batch_context.json").read_bytes())
        require(result["ids"] == self.ids and result["actors"] == ACTORS, "Batch reservation/actor identity changed")
        require(json.loads(self.store.object(result["batch_context_sha256"])) == result["context"], "Batch context differs from frozen object")
        return result

    def path(self, rid, version, role):
        return self.home / FOLDERS[role] / f"{rid}_v{version}{SUFFIXES[role]}.json"

    def receipt(self, rid, version, role):
        return self.home / "receipts" / f"{rid}_v{version}_{role}.json"

    def pump(self):
        spec = self.spec()
        known = {(p["record_id"], p["version"], p["role"]): p for e in self.store.ledger() if e["kind"] == "SUBMISSION" for p in [e["payload"]]}
        imported, pending, failures = [], [], []
        for rid in self.ids:
            for version in range(1, 5):
                for role in ACTORS:
                    path = self.path(rid, version, role)
                    if not path.exists():
                        continue
                    raw = path.read_bytes()
                    if raw != path.read_bytes() or not raw.endswith(b"\n"):
                        pending.append(path.relative_to(self.root).as_posix())
                        continue
                    key = rid, version, role
                    if key in known:
                        require(digest(raw) == known[key]["payload_sha256"], "Frozen submitted artifact changed: " + str(path))
                        receipt = self.receipt(*key)
                        if not receipt.exists():
                            atomic_json(receipt, known[key])
                        continue
                    try:
                        payload = json.loads(raw)
                        require(encoded(payload) == raw, "Canonical encoded JSON bytes required")
                        require((payload["record_id"], payload["version"], payload["role"]) == key, "Artifact filename/content identity mismatch")
                        require(payload["actor"] == ACTORS[role], "Assigned independent actor mismatch")
                        require(payload.get("batch_context_sha256") == spec["batch_context_sha256"], "Frozen batch context required")
                        if role != "author" and (rid, version, "author") not in known:
                            pending.append(path.relative_to(self.root).as_posix())
                            continue
                        if role == "judge" and (rid, version, "reviewer") not in known:
                            pending.append(path.relative_to(self.root).as_posix())
                            continue
                        result = self.store.submit(payload)
                        require(result["payload_sha256"] == digest(raw), "Source artifact bytes differ from submitted bytes")
                        atomic_json(self.receipt(*key), result)
                        known[key] = result
                        imported.append(f"{rid} v{version} {role}")
                    except (ValueError, KeyError, json.JSONDecodeError) as error:
                        failures.append({"record_id": rid, "version": version, "role": role, "path": path.relative_to(self.root).as_posix(), "sha256": self.store.freeze(raw), "reason": str(error)})
        result = {"imported": imported, "pending": pending, "failures": failures, "native_states": dict(Counter(r["state"] for r in self.store.native_status()))}
        atomic_json(self.home / "pump_status.json", result)
        return result

    def card(self, rid, version, category, reason, decisions, paths, source_detail=""):
        path = self.root / "human_review/blockers" / f"{rid}_v{version}_{category}_human_review.md"
        lines = [f"# Human review: {rid} v{version} — {category.replace('_', ' ')}", "",
                 "Queued 10 October 2026 (Asia/Calcutta). Status: OPEN. This closes automated review only; no approval or release is implied.", "",
                 f"Manual SHA-256: `{MANUAL_SHA}`.", "", "Reason: " + reason, ""]
        if source_detail:
            lines += ["Specific source/assembly limitation: " + source_detail, ""]
        lines += ["Exact materials (preserved in place):", ""]
        for role, sha in decisions.items():
            location = paths.get(role)
            lines.append(f"- {role}: `{location or 'MISSING'}` — SHA-256 `{sha or 'MISSING'}`")
        if category == "checksum_binding":
            action = "Obtain a separately authored reviewer source-checksum attestation/supplement tied to this exact draft and review, or perform content-bound human original-page review. Do not edit the frozen review or retrospectively invent its inspection scope. The recorded judge verdict stays distinct from this audit hold."
        elif category == "source_gap":
            action = "Independently check the cited original pages and complete missing evidence/procedure/conditions/warnings or seek OEM clarification. Determine whether this is missing manual guidance, unclear source wording, or incomplete engineering assembly. Preserve the limited abstention until that scope is resolved."
        else:
            action = "Adjudicate the exact unresolved findings and source spans, complete missing audit bindings if needed, and approve only the checked scope through the formal human workflow. The bounded automated loop cannot resolve this issue; preserve all previous versions."
        lines += ["Decision required: " + action, "", "Independent agent review, conversational acceptance, formal source/evidence/rule/dependency approval and release are separate decisions. Never ask a rider to resolve this maintainer/source gap.", ""]
        exclusive_text(path, "\n".join(lines))
        return path.relative_to(self.root).as_posix()

    def legacy_blockers(self):
        report = json.loads((self.store.home / "inventory.json").read_bytes())
        cards = []
        for row in report["records"]:
            if row["state"] != "BLOCKED_BINDING":
                continue
            cards.append(self.card(row["record_id"], row["version"], "checksum_binding", row["reason"],
                       {"author": row["draft_sha256"], "reviewer": row["review_sha256"], "judge": row["judgment_sha256"]},
                       {"author": row["draft_path"], "reviewer": row["review_path"], "judge": row["judgment_path"]}))
        atomic_json(self.home / "legacy_audit_blockers.json", {"cards": cards, "count": len(cards), "source_inventory_sha256": digest((self.store.home / "inventory.json").read_bytes())})
        return cards

    def status(self):
        spec = self.spec()
        records = self.store.native_status()
        by_id = {r["record_id"]: r for r in records}
        return {"expected": 100, "created": sum(rid in by_id for rid in self.ids), "counts": dict(Counter(by_id[rid]["state"] if rid in by_id else "AWAITING_AUTHOR" for rid in self.ids)), "batch_context_sha256": spec["batch_context_sha256"], "records": [by_id.get(rid, {"record_id": rid, "state": "AWAITING_AUTHOR"}) for rid in self.ids]}

    def finish(self):
        spec = self.spec()
        manifest_path = self.store.home / "batch_100_completion.json"
        require(not manifest_path.exists(), "Completion manifest already exists; preserve its exact version")
        state = self.status()
        require(state["created"] == 100, "All 100 unique records must exist")
        records, intents, terminal_counts = [], set(), Counter()
        for row in state["records"]:
            rid, version = row["record_id"], row["version"]
            require(row["state"] in TERMINAL, f"{rid} is not terminal: {row['state']}")
            require(set(row["roles"]) == set(ACTORS), f"{rid} lacks a full independent three-role loop")
            files, hashes = {}, {}
            for role in ACTORS:
                payload = row["roles"][role]
                path = self.path(rid, version, role)
                require(path.exists() and digest(path.read_bytes()) == payload["payload_sha256"], f"{rid} {role} current artifact mismatch")
                require(payload["actor"] == ACTORS[role] and payload.get("batch_context_sha256") == spec["batch_context_sha256"], "Independent actor/context binding failed")
                files[role], hashes[role] = path.relative_to(self.root).as_posix(), payload["payload_sha256"]
            author, review, judge = (row["roles"][r] for r in ACTORS)
            require(author["origin_declaration"] == ORIGIN, "Origin declaration missing")
            intent = author.get("distinctive_intent", "").strip().casefold()
            require(intent and intent not in intents, "Missing/duplicate substantive intent label")
            intents.add(intent)
            require(review["author_sha256"] == hashes["author"] and judge["author_sha256"] == hashes["author"] and judge["review_sha256"] == hashes["reviewer"], "Final exact artifact hashes do not agree")
            require(author["manual_sha256"].lower() == review["manual_sha256"].lower() == judge["manual_sha256"].lower() == MANUAL_SHA, "Final source checksum mismatch")
            blockers = []
            if row["state"] != "PASS_AGENT_REVIEW":
                category = "source_gap" if row["state"] == "BLOCKED_SOURCE_GAP" else "bounded_loop"
                detail = json.dumps({"review_findings": review["findings"], "judge_findings": judge["findings"], "feedback_disposition": judge["feedback_disposition"]}, ensure_ascii=False)
                blockers.append(self.card(rid, version, category, judge["reason"], hashes, files, detail))
            terminal_counts[row["state"]] += 1
            records.append({"record_id": rid, "version": version, "terminal_disposition": row["state"], "expected_route": author["expected_route"], "distinctive_intent": author["distinctive_intent"],
                            "draft_path": files["author"], "draft_sha256": hashes["author"], "review_path": files["reviewer"], "review_sha256": hashes["reviewer"],
                            "judge_path": files["judge"], "judge_sha256": hashes["judge"], "reason": judge["reason"], "blocker_card_paths": blockers,
                            "revision_cycles": version - 1, "human_acceptance": "NOT_RECORDED", "formal_source_approval": "PENDING", "runtime_authorized": False})
        require(len(records) == len({r["record_id"] for r in records}) == 100, "100 unique records required")
        self.store.ledger()
        for path in (self.store.home / "objects").glob("*"):
            self.store.object(path.name)
        manifest = {"schema_version": 1, "batch_id": spec["batch_id"], "status": "COMPLETE_AGENT_LOOP_WITH_EXPLICIT_BLOCKS" if sum(terminal_counts.values()) != terminal_counts["PASS_AGENT_REVIEW"] else "COMPLETE_AGENT_LOOP",
                    "completed_at_utc": datetime.now(timezone.utc).isoformat(), "batch_context_sha256": spec["batch_context_sha256"], "manual_sha256": MANUAL_SHA,
                    "expected_count": 100, "actual_unique_count": 100, "all_terminal": True, "counts": dict(terminal_counts), "records": records,
                    "human_approval": False, "formal_source_approval": False, "release_approved": False, "catalogue_path": "human_review/record_catalogue.md",
                    "refinement_dependency_chat": "01a121fc-f04c-7983-bb9e-e3acbd3aa072", "origin_declaration": ORIGIN}
        manifest_sha = self.store.freeze(encoded(manifest))
        self.store.append("BATCH_COMPLETED", {"manifest_sha256": manifest_sha, "record_count": 100, "counts": dict(terminal_counts)})
        atomic_json(manifest_path, manifest)
        return manifest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("init", "pump", "status", "legacy-blockers", "finish"))
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[2])
    args = parser.parse_args()
    batch = Batch(args.root)
    with batch.store.lock():
        result = {"init": batch.init, "pump": batch.pump, "status": batch.status, "legacy-blockers": batch.legacy_blockers, "finish": batch.finish}[args.command]()
    if args.command in {"status", "finish", "init"}:
        result = {k: v for k, v in result.items() if k not in {"records", "context", "ids"}}
    print(json.dumps(result, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
