    "policy_2fe0f629672c02de61ce02a0": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_2fe0f629672c02de61ce02a0",
      "exact_text": "During versioned ingestion, bind each searchable child chunk to its full parent procedure or section and build a reviewed dependency manifest for every actionable step. The manifest identifies the action spans, applicability conditions, prerequisites, warnings, table headers and units, variant labels, and referenced figures or sections required to present that step. A section parent remains contextual evidence until its procedure and step boundaries have been reviewed.",
      "paragraph_index": 78,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "7f96a1c81d9fdfd2f7b4820ea2da799960445761949017a124c78260319b69de",
      "text_span": [
