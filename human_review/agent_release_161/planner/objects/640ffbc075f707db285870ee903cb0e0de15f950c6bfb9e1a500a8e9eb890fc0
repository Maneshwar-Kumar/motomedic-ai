    },
    "policy_95404262f128f047d07a3abb": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_95404262f128f047d07a3abb",
      "exact_text": "Key checksum, confirmed variant, intent/symptoms, typed outcomes, flow/controller, policy and prompt versions; invalidate on relevant rule/review/dependency changes; draft/stale entries miss",
      "paragraph_index": 183,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "3adbadcc2b4048f83ac8ebafe0b87f253a499a963018ae9a46aba969c5d33473",
      "text_span": [
        0,
        190
      ],
      "version": "TRD-v0.4"
    },
    "policy_955b79fbf2d1a14c6d8e4b82": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_955b79fbf2d1a14c6d8e4b82",
      "exact_text": "Do not include proprietary manuals in an unrestricted public repository without verifying usage rights; use private asset storage or a permitted manual",
      "paragraph_index": 226,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "a5b184c3de3551b20622b10c44ec6ff3e240e7aa0f925aab9577bfedbb359319",
      "text_span": [
        0,
        151
      ],
      "version": "TRD-v0.4"
    },
    "policy_96d4dac2d0dc0a5141a622c0": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_96d4dac2d0dc0a5141a622c0",
      "exact_text": "Model/version switch invalidates procedural branch assumptions and requires explicit reconfirmation",
      "paragraph_index": 120,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "e0a6634c50415d19aa39f26b39290ce98826d26fc77d1c5242fdf01178bd61e4",
      "text_span": [
        0,
        99
      ],
      "version": "TRD-v0.4"
    },
    "policy_97a60a6e9e665515e18e9c89": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_97a60a6e9e665515e18e9c89",
      "exact_text": "Apply hard filters by selected manual ID, model/variant, publication version and language before ranking",
      "paragraph_index": 72,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "9208166fdcafbaa203b11faac346f17ae3b0b7dc6527968893da596af176629a",
      "text_span": [
        0,
        104
      ],
      "version": "TRD-v0.4"
    },
    "policy_a582429020c644c2e81622ed": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_a582429020c644c2e81622ed",
      "exact_text": "When a user reports resolution, close as customer-reported, not mechanically verified",
      "paragraph_index": 124,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "bd1939ba610686dae57a617559ff3e702cd520ce8f0da577967cfd060bb3fe2a",
      "text_span": [
        0,
        85
      ],
      "version": "TRD-v0.4"
    },
    "policy_a8dcf4b93553e36118cdff05": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_a8dcf4b93553e36118cdff05",
      "exact_text": "Apply file size/type limits, per-user rate limits and a per-day spending cap; sanitize PDF text as data, not executable instructions",
      "paragraph_index": 225,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "384b8d8cf24999c2be61af7cda103277bb652bc036dc8e17215cea74af684d45",
      "text_span": [
        0,
        132
      ],
      "version": "TRD-v0.4"
    },
    "policy_acd6cd4d0155375bc4a88c59": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_acd6cd4d0155375bc4a88c59",
      "exact_text": "Trigger signals compare distinct parent sections: disagreement between dense and BM25 top sections, or a narrow relative RRF margin between the two leading sections. Sibling chunks from the same section do not create ambiguity. Zero BM25 matches provide no sparse-agreement signal. Initial experimental values are top-three section overlap below 0.5 or relative RRF margin at most 0.05. Mark these values PROVISIONAL_UNCALIBRATED; use reviewed tuning cases to calibrate them and held-out cases to assess their effect before a release decision.",
      "paragraph_index": 83,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "6c28581c60ac5f8d96c48d53be0c1fe369fb56d6b14e31751a7843836b168c88",
      "text_span": [
        0,
        543
      ],
      "version": "TRD-v0.4"
    },
    "policy_b55b613087e81a2f9a33f08f": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_b55b613087e81a2f9a33f08f",
      "exact_text": "Version together: manual checksum, parser version, chunking parameters, embedding model, index build, graph build, step registry, applicability rules, dependency manifests and review decisions, controller policy, retrieval policy and trigger thresholds, calibration dataset and approval, reranker, generator, system prompt, verifier and evaluation set. Rule, review, dependency or policy changes invalidate affected exact-cache entries and require revalidation of affected cases. All comparisons must use the same held-out cases.",
      "paragraph_index": 259,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "30f5e7f2d0cbd948e4b46697e1516100c9f3359eb5ba7afa9e882c91d232449e",
      "text_span": [
        0,
        529
      ],
      "version": "TRD-v0.4"
    },
    "policy_c0ef3f05285a25b655047e95": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_c0ef3f05285a25b655047e95",
      "exact_text": "Use OpenTelemetry-compatible spans and a tracing/evaluation backend such as Langfuse. Scrub raw user media and redact accidental personal information.",
      "paragraph_index": 220,
      "source_path": "03_TRD.docx",
