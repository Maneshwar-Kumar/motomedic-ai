    "policy_41923c171e76e73362928b4e": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_41923c171e76e73362928b4e",
      "exact_text": "Create candidate StepDefinition and ApplicabilityRule records from the original owner manual during ingestion. A layout parser or model may propose the records, but an independent reviewer must check each action, condition, prerequisite, warning and stopping condition against the original pages before it becomes runtime-authorized. Record the reviewer, decision, source spans and registry version. Draft, rejected, stale or checksum-mismatched rules must not authorize an action or a cached answer.",
      "paragraph_index": 94,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "ed1e797d52465046b27da59cec5fe35b801875424cad133352745e7ebb6af6ef",
      "text_span": [
        0,
        500
      ],
