    "policy_37f584879348266e8e42a675": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_37f584879348266e8e42a675",
      "exact_text": "{\"manual_identification\": \"PDF page 3 describes 452 cc liquid-cooled Sherpa; pages 1 and 4 state BS VI.\", \"market_or_region\": \"Not independently confirmed; no rider market prompt required under owner selection policy.\", \"model_year_required\": false, \"owner_confirmed_on\": \"2026-10-09\", \"rider_edition_selection_required\": false, \"selection_rule\": \"Rider confirms Himalayan and BS6; supplied immutable manual is selected.\", \"version\": \"owner-himalayan-bs6-v1\"}",
      "json_pointer": "/applicability_policy",
      "source_path": "source_manifest.json",
      "source_sha256": "3b38e5ead40555ba810e94ff758b0cd30e4c874642fe089b6ac52fe97b534e18",
      "text_sha256": "568e5a64ba7fb2d3755991d881a668ae91e1921d6d64401b2b75788bc608213d",
      "text_span": [
