    "policy_5067c2fa98fb514fad94ddf7": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_5067c2fa98fb514fad94ddf7",
      "exact_text": "Abstain with “could not verify an applicable procedure” and verified OEM contact option",
      "paragraph_index": 138,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "8e2bbed2260571150e59246f1fb80dbe38a32a045bf713c162c9afc65b190dcd",
      "text_span": [
