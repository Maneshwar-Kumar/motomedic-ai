    "policy_856cb9f6fbe76bd5e7103080": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_856cb9f6fbe76bd5e7103080",
      "exact_text": "When a reviewed branch condition is UNKNOWN, withhold the dependent action and ask one source-derived question if the rider can resolve it. If a source or extraction gap cannot be resolved by rider feedback, route to review/abstention; operational failures remain SYSTEM_ERROR.",
      "paragraph_index": 114,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "754f87368772cb64c058b342a4721d1ef9b20d84fb52e1dfe0f69d97101e4d9e",
