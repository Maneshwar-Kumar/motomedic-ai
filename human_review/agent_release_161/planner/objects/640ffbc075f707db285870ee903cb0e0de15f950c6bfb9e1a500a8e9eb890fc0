    "policy_64b427692eb932980612b66d": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_64b427692eb932980612b66d",
      "exact_text": "The assembler returns required_evidence_ids, attached_evidence_ids and missing_evidence_ids for the selected candidate, together with dependency_manifest_version and dependency_review_status. missing_evidence_ids is the required set minus the attached set. Coverage is complete only when the dependency manifest is approved for the exact manual checksum, the action evidence is present, all required objects are attached, and their content and provenance pass extraction checks. An empty or unreviewed required set cannot establish sufficiency. Finding a table object is insufficient if its required headers, units or variant context are missing.",
      "paragraph_index": 79,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "ebc2a6d5773da46045c22f1fa12d8edbc891ca0de3faa5d66c4833e6cde3b839",
      "text_span": [
        0,
        646
      ],
      "version": "TRD-v0.4"
    },
    "policy_680d331344f35db68e62a9cf": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_680d331344f35db68e62a9cf",
      "exact_text": "Every manual-derived predicate must retain its supporting evidence IDs and page provenance. Record origin as MANUAL for OEM conditions and PRODUCT_POLICY for application behavior such as avoiding repeated attempts; policy rules carry their own version and must never be presented as OEM instructions. Relevance tags and rider intent mappings help select candidates, while the reviewed predicates establish applicability. Uncertain interpretation of the rider report remains an unknown observation until clarified.",
      "paragraph_index": 95,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "a487e8c72f29656528681e11cdbc44e6c915e6949ec6618d8ac46c5ec9812876",
      "text_span": [
        0,
        513
      ],
