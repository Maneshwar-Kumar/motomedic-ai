    "policy_8afbff4564e2ae04dba8b809": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_8afbff4564e2ae04dba8b809",
      "exact_text": "{\"checked_date\": \"2026-10-09\", \"email\": \"support@royalenfield.com\", \"market\": \"India\", \"market_fit_status\": \"PENDING_SOURCE_MARKET_CONFIRMATION\", \"owner_requested\": true, \"url\": \"mailto:support@royalenfield.com\", \"verification_url\": \"https://www.royalenfield.com/in/en/support/digital-quickstart/new-himalayan/contact-us/\", \"verified\": true, \"wording\": \"Kindly write to Royal Enfield at support@royalenfield.com\"}",
      "json_pointer": "/oem_service_route",
      "source_path": "source_manifest.json",
      "source_sha256": "3b38e5ead40555ba810e94ff758b0cd30e4c874642fe089b6ac52fe97b534e18",
      "text_sha256": "db4cc0817e52a622bacff23a79559ce2e577237c952436a539da82d3b5dc2480",
