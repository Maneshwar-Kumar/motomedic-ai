    "policy_51734b8fe6d0889c31e59d8f": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_51734b8fe6d0889c31e59d8f",
      "exact_text": "Cosine similarity and reranker scores are relevance heuristics, never proof that an instruction is supported",
      "paragraph_index": 76,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "60113a9da8a1cf82f18858e8c35db03566d8502ee2228a3e959269835eb38897",
      "text_span": [
