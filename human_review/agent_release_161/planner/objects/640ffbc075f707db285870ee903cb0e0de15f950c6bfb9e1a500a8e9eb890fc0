    "policy_c27718acc88fc45209919b52": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_c27718acc88fc45209919b52",
      "exact_text": "Photo input: validate size/type, run vision extraction into observations {component_hint, visible_feature, uncertainty, needs_clarification}; no root-cause diagnosis from vision alone",
      "paragraph_index": 146,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "496d62c0df946fe0d9cd2f3075c4f2054c1ecd0e8a97e8cd855e4be2cdbf9b32",
      "text_span": [
