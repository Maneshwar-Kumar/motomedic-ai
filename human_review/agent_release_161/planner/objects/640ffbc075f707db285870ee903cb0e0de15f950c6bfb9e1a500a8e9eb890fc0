    "policy_240aa9e9a20851d2f8253ffc": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_240aa9e9a20851d2f8253ffc",
      "exact_text": "Evaluate reviewed conditions against typed session facts using TRUE, FALSE and UNKNOWN. A condition is UNKNOWN when its observation is missing, uncertain or invalid; a confirmed mismatch is FALSE. A step is ineligible when any required condition is FALSE, its source or review status is invalid, its branch has been validly excluded, or its attempt history blocks repetition. If no required condition is false but a relevant condition is unknown, withhold the action and ask one reviewed source-derived question when the rider can reliably resolve it. Unknown is never treated as true or normal.",
      "paragraph_index": 98,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "3240ebabe8d80af3f809643a7d378c660d294cd5c8450c4ead1359c4c9f589c8",
      "text_span": [
