    },
    "policy_63ffa2aaad16f26adfb3e8cb": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_63ffa2aaad16f26adfb3e8cb",
      "exact_text": "If an approved dependency set is incomplete, permit one bounded recovery that fetches the exact required objects and widens retrieval once. If dependencies remain unavailable, withhold technical advice and record a non-rider-resolvable source gap. Allow at most one subsequent reranking attempt when ordering remains uncertain and all source/applicability checks permit it; never loop between search, reranking and generation.",
      "paragraph_index": 75,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "ec3a2e44139bb60e0540c183471b5eb39446ed42c2ea7d60adb7c9029fc3e683",
      "text_span": [
