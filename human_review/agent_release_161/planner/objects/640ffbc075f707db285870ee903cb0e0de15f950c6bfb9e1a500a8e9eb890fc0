    "policy_9111e6e2299a2b15cf63eeb7": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_9111e6e2299a2b15cf63eeb7",
      "exact_text": "Implement rule predicates with allowlisted typed comparisons such as enum equality, boolean facts and numeric comparisons with explicit units. Treat the PDF and model output as data; do not execute extracted expressions as code. Return an EligibilityDecision with each condition result, reason code, evidence reference, registry version and session version. ACTION_COMPLETED_UNRESOLVED records an attempted action and never supplies an OBSERVED_NORMAL fact. Optional interpretation models may propose typed observations or rank already eligible candidates; their output cannot bypass the controller gates.",
      "paragraph_index": 100,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "6a73c9d4eea9eb521c91445fdf2a93db553e367fd33eca7f7a6bd5e851225dcc",
      "text_span": [
        0,
        605
      ],
      "version": "TRD-v0.4"
    },
    "policy_92d58d1828c67f67c189cfe8": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_92d58d1828c67f67c189cfe8",
      "exact_text": "Perform the existing bounded recovery search for missing dependencies and record its outcome. A source gap that the rider cannot resolve must block the instruction and enter source review or abstention; do not ask the rider to supply a missing manual warning or table header. Retrieval outages, invalid index objects and other operational failures return SYSTEM_ERROR. Cross-encoder scores rank relevance and cannot approve a dependency manifest, infer a diagnostic order or waive missing evidence.",
      "paragraph_index": 80,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "b803b3addcec6f014ce7554911e271a4b5d671df6eeda73609e694a6f39f1f32",
      "text_span": [
        0,
        498
      ],
      "version": "TRD-v0.4"
    },
    "policy_94d98bcf79f7faecba16976a": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_94d98bcf79f7faecba16976a",
      "exact_text": "Only structured observed outcomes can eliminate a branch; “tried but still failing” must not be converted into “normal”",
      "paragraph_index": 108,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "a948a303d91619c2188649060c1abbcd452a0b019d268ab8a469de41dafb991c",
