    "policy_3e3b8efa31c773a1efa06753": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_3e3b8efa31c773a1efa06753",
      "exact_text": "SUPPORTED requires an eligible action or applicable factual answer, an approved and complete dependency set, valid citations, satisfied safety and prerequisite checks, and successful final claim validation. The controller may authorize generation of a draft after next-step selection; the final response is marked SUPPORTED only after both validation layers pass. Rejected drafts remain withheld. Retry within a bounded policy, then return SYSTEM_ERROR for generation/verification failure or UNSUPPORTED for an established source gap; never disguise a system failure as absence in the manual.",
      "paragraph_index": 130,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "0bdcb3ffb8d7b3c4648e78251b63beb223c7ccfdfc660d4e527027c94659fefb",
      "text_span": [
