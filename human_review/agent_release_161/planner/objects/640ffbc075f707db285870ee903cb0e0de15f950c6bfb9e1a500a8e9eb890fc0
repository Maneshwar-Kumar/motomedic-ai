    "policy_4bacac5bf58eb3c06b73fef3": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_4bacac5bf58eb3c06b73fef3",
      "exact_text": "Display the applicable source warning, stop unsafe action and refer to authorized service as supported",
      "paragraph_index": 140,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "76e299cd636f6de40c315a46ccbe859bf82772dc3891697fd1035a33377acf98",
