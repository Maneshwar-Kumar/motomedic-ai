      "evidence_id": "policy_303787821f29b1deb8fe9f76",
      "exact_text": "If no eligible documented step remains, issue OEM escalation with a concise traceable recap",
      "paragraph_index": 118,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "82a862edf87ca60c9eade76a8fc27ebdda79de1f4768760e821e502e8bf9f30a",
