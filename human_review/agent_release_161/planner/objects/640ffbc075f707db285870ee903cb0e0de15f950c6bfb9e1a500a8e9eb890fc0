    "policy_c6a2f0ec55f020264f579536": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_c6a2f0ec55f020264f579536",
      "exact_text": "OEM referral if no valid path remains",
      "paragraph_index": 29,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "84187ef753c4f4f1c4e5102cc4f8ac13fe4627066ca606642001be420dda60b3",
      "text_span": [
