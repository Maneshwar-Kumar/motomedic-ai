    },
    "policy_46f874c8ba7f9aaffdd16ed8": {
      "authority": "PRODUCT_POLICY",
      "evidence_id": "policy_46f874c8ba7f9aaffdd16ed8",
      "exact_text": "Do not repeat attempted steps unless the customer corrects an observation, new symptoms change applicability, or the manual explicitly requires a repeat; explain why",
      "paragraph_index": 116,
      "source_path": "03_TRD.docx",
      "source_sha256": "aeedf6789ddfbddc674c1926c5d4441a27708bd260c673d876a5ff7fdb3792ac",
      "text_sha256": "c5fdc9f0a3e31b5bb742b1f95eda1cb2c63dc72806fb2bed7f278c83bbfee0e0",
